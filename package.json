{
  "name": "threads-affiliate-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Threads affiliate automation — 1 sumber data (Google Sheet 'JADWAL THREADS'), auto-post 3 utas berantai (hook / produk+gambar / reply link) ke Threads, tarik insights. Jalan di GitHub Actions.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --env-file-if-exists=.env scripts/check-setup.js",
    "preview": "node --env-file-if-exists=.env scripts/preview.js",
    "set-cell": "node --env-file-if-exists=.env scripts/set-cell.js",
    "delete-column": "node --env-file-if-exists=.env scripts/delete-column.js",
    "publish": "node --env-file-if-exists=.env scripts/run-publish.js",
    "insights": "node --env-file-if-exists=.env scripts/run-insights.js",
    "get-token": "node --env-file-if-exists=.env scripts/get-threads-token.js",
    "test": "node --test",
    "rename-tab": "node --env-file-if-exists=.env scripts/rename-tab.js",
    "generate-from-brief": "node --env-file-if-exists=.env scripts/run-generate-from-brief.js",
    "conversion-report": "node --env-file-if-exists=.env scripts/run-conversion-report.js",
    "backfill-row-id": "node --env-file-if-exists=.env scripts/backfill-row-id.js",
    "shopee:introspect": "node --env-file-if-exists=.env scripts/shopee-introspect.js"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "googleapis": "^140.0.1",
    "libsodium-wrappers": "^0.8.4"
  }
}
