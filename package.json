{
  "name": "threads-affiliate-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Threads affiliate automation — sync konten dari Google Docs, auto-post 3 utas berantai (hook / produk+gambar / reply link) ke Threads, tarik insights. Jalan di GitHub Actions.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --env-file-if-exists=.env scripts/check-setup.js",
    "preview": "node --env-file-if-exists=.env scripts/preview.js",
    "set-cell": "node --env-file-if-exists=.env scripts/set-cell.js",
    "delete-column": "node --env-file-if-exists=.env scripts/delete-column.js",
    "sync": "node --env-file-if-exists=.env scripts/run-sync.js",
    "publish": "node --env-file-if-exists=.env scripts/run-publish.js",
    "insights": "node --env-file-if-exists=.env scripts/run-insights.js",
    "get-token": "node --env-file-if-exists=.env scripts/get-threads-token.js",
    "test": "node --test",
    "doc-dump": "node --env-file-if-exists=.env scripts/doc-dump.js",
    "rename-tab": "node --env-file-if-exists=.env scripts/rename-tab.js",
    "build:dashboard": "node --env-file-if-exists=.env scripts/build-dashboard-data.js"
  },
  "dependencies": {
    "googleapis": "^140.0.1",
    "libsodium-wrappers": "^0.8.4"
  }
}
