# === Google ===
# Lokal: path ke file JSON service account
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./threads-affiliate-personal-636a7218e346.json
# CI (GitHub Actions) pakai pasangan ini sebagai gantinya:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...
# GOOGLE_PRIVATE_KEY=...

# === Sumber data (isi ID-nya, ambil dari URL masing-masing) ===
THREADS_TRACKER_SPREADSHEET_ID=
THREADS_DRIVE_IMAGE_FOLDER_ID=
THREADS_SHEET_NAME=JADWAL THREADS

# === Threads API ===
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# === Cuma buat scripts/get-threads-token.js ===
THREADS_APP_SECRET=
SHORT_LIVED_TOKEN=

# === Opsional ===
# DRY_RUN=1                # simulasi, tidak nulis ke Sheet / tidak post ke Threads
# SECRETS_WRITE_PAT=       # cuma dipakai di GitHub Actions
